# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional. If set (or if GEMINI_API_KEY starts with "sk-or-"),
# requests are routed through OpenRouter instead of Google Gemini.
# OPENROUTER_API_KEY=""

# Optional: override the AI model failover order (comma-separated).
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash-lite,gemini-2.5-flash"
# OPENROUTER_MODELS="liquid/lfm-2.5-2.6b:free,openrouter/free"

# Optional: total time budget (ms) for the whole model failover chain. Default 20000.
# AI_TOTAL_BUDGET_MS=20000

# Optional: max AI-backed requests per IP per minute (0 = disabled). Default 30.
# RATE_LIMIT_PER_MIN=30

# Evidence engine (server/reputation.ts). Each source is downloaded in the background and cached in .cache/.
# GOOGLE_SAFE_BROWSING_API_KEY: optional, adds Google Safe Browsing lookups.
# GOOGLE_SAFE_BROWSING_API_KEY=""
# Set to "off" to disable a source (with all sources on, the server used ~285 MB RAM in testing).
# POPULARITY_LIST=off       # Tranco top-200k popularity ranking
# THREAT_FEEDS=off          # Phishing.Database + OpenPhish blacklists
# DOMAIN_AGE_LOOKUP=off     # RDAP domain registration date
# REPUTATION_CACHE_DIR=".cache/reputation"

# Deep-learning models (server/models/*.bin.gz). Retrain with:
#   npx tsx scripts/train-url-model.ts      (domain-name model, trained on Phishing.Database + Tranco)
#   npx tsx scripts/train-content-model.ts  (page-content model, trained on the knowledge-distilled corpus in scripts/content-corpus.ts)
# URL_MODEL=off
# CONTENT_MODEL=off

# ==============================================================================
# JEV & OPENJEV DECISION GATEWAY (Tùy chọn trọng tài ra quyết định vùng xám)
# ==============================================================================
# JEV_MODE:
#   - off     : (Mặc định) Không dùng trọng tài; kết luận theo bằng chứng + 2 mô hình học sâu nội bộ.
#   - api     : Dùng Jev của TypeSafe AI (https://typesafe.ai). Lấy API key tại https://console.typesafe.ai/keys
#   - openjev : Dùng một máy chủ tự host tương thích Jev (vd các dự án "OpenJev" trên GitHub) qua OPENJEV_ENDPOINT.
#   - veritytrust : VerityTrust Decision Engine qua cổng OpenAI-compatible (POST /v1/chat/completions).
# api và openjev dùng chuẩn System One: POST /v1/systemone { model, state, questions } -> { answers }.
# Chỉ được gọi cho ca vùng xám (45 - 74 điểm) ở Tầng 4.
JEV_MODE="off"

# Cấu hình khi dùng JEV_MODE="api":
# JEV_API_KEY=""                 # hoặc TYPESAFE_API_KEY
# JEV_MODEL="jev-latest"
# JEV_API_URL="https://api.typesafe.ai/v1/systemone"

# Cấu hình khi dùng JEV_MODE="openjev":
# OPENJEV_ENDPOINT="http://localhost:8080/v1/systemone"
# OPENJEV_API_KEY=""

# Cấu hình khi dùng JEV_MODE="veritytrust":
VERITYTRUST_ENGINE_KEY="sk-f6551dc34f863174-7c31cd-38eefffd"   # key dùng chung (free, có giới hạn lượt gọi)
# VERITYTRUST_ENGINE_URL="http://homenasproxmox.duckdns.org:20128/v1/chat/completions"
# VERITYTRUST_ENGINE_MODEL="veritytrust-fast-decision/veritytrust-fast-decision"   # tên model theo kênh OmniRoute (xem GET /v1/models)

# JEV_TIMEOUT_MS=5000            # quá thời gian thì giữ kết luận theo bằng chứng
# JEV_SHADOW=true                # chạy ngầm: vẫn hỏi trọng tài, ghi kết quả vào score_breakdown.jev_decision nhưng KHÔNG đổi điểm
# JEV_GRAY_ZONE_ONLY=false       # chỉ có tác dụng khi JEV_SHADOW=true: hỏi trọng tài cho mọi web (để đo), không riêng vùng xám


# Tier 3 of the scanning pipeline (server/headless.ts): render SPA / near-empty pages with a real browser.
# auto (default) = use it when Google Chrome / Chromium is found; on | off. Every browser request goes through the SSRF guard.
# HEADLESS_RENDER=auto
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# HEADLESS_TIMEOUT_MS=8000
# HEADLESS_CONCURRENCY=2
